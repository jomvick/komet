{
  // www.komet.sh → komet.sh canonicalization. The zone has a proxied DNS
  // record for www but no origin behind it, so without this route Cloudflare
  // answers 525. A zone route (not a custom domain) rides that existing
  // record. Redirect rules would be cleaner but need zone rulesets write,
  // which the deploy token doesn't have.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "komet-www-redirect",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "account_id": "b57dde68ee5964dccc025437b5478a5b",
  "workers_dev": false,
  "routes": [{ "pattern": "www.komet.sh/*", "zone_name": "komet.sh" }]
}
