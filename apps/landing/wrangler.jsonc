{
  // Landing page: pure static assets, no worker script. The install surface
  // (/install.sh, /releases/*) is served by the edge worker via path routes on
  // the same hostname — path routes beat this custom domain, so this worker
  // only ever sees page traffic. Deploy with `npx wrangler deploy` from this
  // dir. (The worker keeps its historical "komet-landing" name; renaming a
  // worker means a new worker. komet.komet.sh stays attached for old links.)
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "komet-landing",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "komet.sh", "custom_domain": true },
    { "pattern": "komet.komet.sh", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "public"
  }
}
