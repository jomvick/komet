/target
**/*.rs.bk
# Local-only scratch space — holds signing/notary credentials, never commit.
/ignore/
# Freebuff tool state — never commit.
/.freebuff/
*.pdb
.DS_Store
.env
.env.local
node_modules
.wrangler
build/
edge/dist/
# Per-scenario shims generated at test runtime by crates/harness/tests/acp.rs
# (they pin SCENARIO / env for the fake agents); only the real fixtures are tracked.
crates/harness/tests/fixtures/fake-cline-acp-*.sh
crates/harness/tests/fixtures/fake-acp-*.sh
